#!/bin/bash
# find_dir - fd + fzf-tmux 디렉토리 선택기.
#
# 고른 디렉토리의 절대 경로를 출력한다. 이동(cd)은 호출부가 한다.
# 선택 도중 하위 디렉토리가 있으면 같은 선택기를 한 단계 더 띄운다.
#
#   j   (zsh 함수)  ->  cd "$(find_dir)"
set -u

HIDDEN_STATE=/tmp/fzf-dir-hidden-state
DEPTH_STATE=/tmp/fzf-dir-depth-state

show_hidden=${1:-0}
depth=1
base="$PWD"

cleanup() { rm -f "$HIDDEN_STATE" "$DEPTH_STATE"; }
trap cleanup EXIT

while :; do
    echo "$show_hidden" > "$HIDDEN_STATE"
    echo "$depth" > "$DEPTH_STATE"

    hidden_flag=""
    hidden_prompt=""
    if [ "$show_hidden" -eq 1 ]; then
        hidden_flag="--hidden -I"
        hidden_prompt="(+hidden) "
    fi

    curr_dir="${base/#$HOME/\~}"

    dir=$(
        cd "$base" || exit 0
        fd --type d $hidden_flag --max-depth "$depth" \
            | awk 'BEGIN{print ".."} {print}' \
            | sort -r \
            | fzf-tmux \
                --prompt="${hidden_prompt}Dir (--depth=${depth}) & ${curr_dir}/" \
                --header="<Alt+h>: toggle hidden, <Alt+1~3>: depth lvl, <Enter>: cd into" \
                --bind "alt-h:transform:
				HIDDEN=\$(cat $HIDDEN_STATE);
				DEPTH=\$(cat $DEPTH_STATE);
				if [[ \$HIDDEN -eq 0 ]]; then
					echo 'reload(fd --type d --hidden -I --max-depth '\$DEPTH' | awk '\''BEGIN{print \"..\"} {print}'\'' | sort -r)+change-prompt((+hidden) Dir (--depth='\$DEPTH') & ${curr_dir}/)+execute-silent(echo 1 > $HIDDEN_STATE)';
				else
					echo 'reload(fd --type d --max-depth '\$DEPTH' | awk '\''BEGIN{print \"..\"} {print}'\'' | sort -r)+change-prompt(Dir (--depth='\$DEPTH') & ${curr_dir}/)+execute-silent(echo 0 > $HIDDEN_STATE)';
				fi" \
                --bind "alt-1:transform:
        HIDDEN=\$(cat $HIDDEN_STATE);
        HIDDEN_FLAG=''; [[ \$HIDDEN -eq 1 ]] && HIDDEN_FLAG='--hidden -I' && PROMPT='(+hidden) ';
        echo 'reload(fd --type d '\$HIDDEN_FLAG' --max-depth 1 | awk '\''BEGIN{print \"..\"} {print}'\'' | sort -r)+change-prompt('\$PROMPT'Dir (--depth=1) & ${curr_dir}/)+execute-silent(echo 1 > $DEPTH_STATE)';" \
                --bind "alt-2:transform:
        HIDDEN=\$(cat $HIDDEN_STATE);
        HIDDEN_FLAG=''; [[ \$HIDDEN -eq 1 ]] && HIDDEN_FLAG='--hidden -I' && PROMPT='(+hidden) ';
        echo 'reload(fd --type d '\$HIDDEN_FLAG' --max-depth 2 | awk '\''BEGIN{print \"..\"} {print}'\'' | sort -r)+change-prompt('\$PROMPT'Dir (--depth=2) & ${curr_dir}/)+execute-silent(echo 2 > $DEPTH_STATE)';" \
                --bind "alt-3:transform:
        HIDDEN=\$(cat $HIDDEN_STATE);
        HIDDEN_FLAG=''; [[ \$HIDDEN -eq 1 ]] && HIDDEN_FLAG='--hidden -I' && PROMPT='(+hidden) ';
        echo 'reload(fd --type d '\$HIDDEN_FLAG' | awk '\''BEGIN{print \"..\"} {print}'\'' | sort -r)+change-prompt('\$PROMPT'Dir (--depth=end) & ${curr_dir}/)+execute-silent(echo 999 > $DEPTH_STATE)';" \
                --preview 'tree --gitignore -dC -L 3 {}'
    )

    # fzf 중단(Esc/Ctrl+C): 지금까지 들어온 경로를 출력해 호출부가 그곳으로 이동한다.
    if [ -z "$dir" ]; then
        printf '%s\n' "$base"
        exit 0
    fi

    if [ "$dir" = ".." ]; then
        base=$(dirname "$base")
    else
        base="$base/$dir"
    fi

    # fd는 첫 인자를 검색 패턴으로 본다. 경로는 cd로 넘긴다.
    if [ "$(cd "$base" && fd --type d --max-depth 1 2>/dev/null | wc -l)" -gt 0 ]; then
        continue
    fi
    break
done

printf '%s\n' "$base"
