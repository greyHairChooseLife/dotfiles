[Desktop Entry]
Type=Application
Name=Ghostty Text Viewer
Comment=Open a text file in Neovim inside a new Ghostty window
# Ghostty's write_scrollback_file:open runs xdg-open. The default handler for
# text/plain is nvim.desktop with Terminal=true, and there is no terminal
# launcher here, so nothing opens. This handler starts its own window instead.
Exec=ghostty --gtk-single-instance=false -e nvim %F
Terminal=false
NoDisplay=true
MimeType=text/plain;
Categories=Utility;TextEditor;
