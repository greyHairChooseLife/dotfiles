# pwndbg를 먼저 로드한다. 없으면 경고만 남기고 pwndbg 전용 설정은 건너뛴다.
python
import os

try:
    gdb.execute("source /usr/share/pwndbg/gdbinit.py")
    _pwndbg = True
except Exception as exc:
    print("gdb: pwndbg not loaded (%s)" % exc)
    _pwndbg = False
end

set disassembly-flavor att
set print pretty on
# pwndbg가 로드 시 output-radix를 16으로 덮어쓴다. radix 16에서는 x/c와 p가 문자 주석 없이
# hex만 출력하므로 10으로 되돌린다. (아래 set은 pwndbg source 이후에 실행되어야 한다.)
set output-radix 10
set backtrace limit 0
set logging file dbg.log
set logging enabled on
set debuginfod enabled on
set history save off

# 부모 프로세스 계속 추적
# set follow-fork-mode parent

python
if _pwndbg:
    for _line in (
        "set show-tips off",
        "set chain-arrow-left ",
        "set chain-arrow-right ",
        "set context-sections regs disasm code stack backtrace expressions threads heap_tracker args",
        "set context-clear-screen on",
        "set context-code-lines 20",
        # pwndbg: 스택이 위에서 아래로 자라게 표시 외?않?되?
        # "set context-stack-lines-reverse on",
    ):
        try:
            gdb.execute(_line)
        except Exception as exc:
            print("gdb: skipped setting (%s)" % exc)
end

# ~/.config/gdb 의 add-on들. 하나가 실패해도 나머지는 계속 로드한다.
python
_gdb_dir = os.path.expanduser("~/.config/gdb")
for _name in ("layout.py", "utils.gdb", "watch_cmd.py", "mark_line_range.py", "mapaddr.py"):
    try:
        gdb.execute("source " + os.path.join(_gdb_dir, _name))
    except Exception as exc:
        print("gdb: skipped %s (%s)" % (_name, exc))
end
