# Ghostty — mirrors dot-config/alacritty/alacritty.toml
# Swap the active terminal in dot-config/i3/config (Mod+Return).
# Reference: https://ghostty.org/docs/config/reference

# --- environment -------------------------------------------------------------

# Keep ghostty's own terminfo entry (not alacritty's xterm-256color). tmux and
# snacks.nvim read the client terminal name from this value: with xterm-256color
# snacks strips the prefix and detects "256color", so it never matches its
# ghostty/kitty entry and reports that the kitty graphics protocol is
# unsupported. "xterm-ghostty" still matches tmux.conf's `xterm*`
# terminal-features, so extended keys and the rest keep working.
term = xterm-ghostty

# alacritty.toml sets [terminal.shell] program = "/bin/zsh", which is a
# non-login zsh. ghostty defaults to $SHELL, already /bin/zsh here.
# command = /bin/zsh

# --- window ------------------------------------------------------------------

# alacritty: decorations = "Buttonless"
window-decoration = none

# alacritty: opacity = 0.95 — needs a compositor, none is running here
background-opacity = 1.0
# alacritty has blur commented out as well (needs a compositor)
# background-blur = 16

# alacritty: dynamic_padding = true
window-padding-balance = true
# alacritty: padding.x / padding.y, commented out there too
# window-padding-x = 1
# window-padding-y = 5

# alacritty never asks before closing. Without this, Mod+q in i3 can leave a
# "close surface?" dialog behind.
confirm-close-surface = false

# No "93x58" banner in the middle of the window while i3 resizes it.
resize-overlay = never

# i3 (super+CR) opens a fresh instance pinned to $HOME, while ctrl+shift+n inside a
# running instance inherits the focused window's cwd. The inherit flag is global
# and beats working-directory, so the i3 launch has to skip single-instance to
# keep "new terminal = $HOME".
window-inherit-working-directory = true
working-directory = home

# --- font --------------------------------------------------------------------

# alacritty: normal.family = "D2KodingLigature Nerd Font Propo"
font-family = D2KodingLigature Nerd Font Propo
# alacritty: size = 13.0 in local.toml
font-size = 12
# only ligature variants of D2Koding are installed, so kill ligatures here
font-feature = -calt
font-feature = -liga
# wider cells: ghostty's default spacing is tighter than alacritty's
adjust-cell-width = 10%
# font-thicken / font-thicken-strength are macOS-only

# --- cursor ------------------------------------------------------------------

# alacritty: cursor.style = { shape = "Block", blinking = "Off" }
cursor-style = block
cursor-style-blink = false
# alacritty: unfocused_hollow = true — ghostty has no unfocused-cursor option

# shell integration sets a bar cursor per zle keymap; keep the block instead
shell-integration-features = no-cursor

# --- keyboard ----------------------------------------------------------------

# Copy / paste / new window already match ghostty's defaults, so no bindings:
#   ctrl+shift+c = copy                (alacritty: Copy)
#   ctrl+shift+v = paste               (alacritty: Paste)
#   ctrl+shift+n = new_window          (alacritty: SpawnNewInstance)

# Same bytes as alacritty's Shift+Return binding (linebreak in claude_code).
keybind = shift+enter=csi:13;2u

# Free Ctrl+Shift+arrows for tmux (bind -n C-S-up/down = switch-client, C-S-left/right
# = select-layout). Ghostty's defaults swallow them first: jump_to_prompt:-1/+1 and
# previous_tab/next_tab. Unbound keys go to the pty, where tmux sees ESC[1;6{A,B,C,D}.
keybind = ctrl+shift+arrow_up=unbind
keybind = ctrl+shift+arrow_down=unbind
keybind = ctrl+shift+arrow_left=unbind
keybind = ctrl+shift+arrow_right=unbind

# alacritty's Ctrl+[ / Ctrl+i hacks are intentionally not copied: ghostty speaks
# the kitty keyboard protocol and tmux here runs `extended-keys on` with
# format csi-u, which gives the same result natively. Kept as a fallback.
# keybind = ctrl+[=csi:27;5;91~
# keybind = ctrl+i=csi:105;5u

# --- performance -------------------------------------------------------------

# alpha-blending stays at its default; `native` washes the whole surface out
gtk-single-instance = true
scrollback-limit-bytes = 20000000

# CRITICAL, not solved yet: alacritty's Alt+u URL hints, Alt+y path-copy hints and
# Alt+i vi mode do not exist in ghostty 1.3.1 (no hint subsystem, no open_url,
# no vi mode). Details and leads: zk note hldhgcfh (task 0e2d3630).

# No auto-reload: Ctrl+Shift+, or `kill -USR2 <pid>` after editing.
