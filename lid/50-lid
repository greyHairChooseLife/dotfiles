#!/bin/bash
# systemd sleep hook (systemd >= 258 reads only /usr/lib/systemd/system-sleep).
# Generated by dotfiles/lid/install.sh — edit dotfiles/lid/50-lid, not this copy.
#
# While a sleep hook runs, systemd has user.slice frozen. So:
#   pre  runs synchronously and keeps no IPC to the session (fast, ~1s)
#   post cannot open a window itself; it queues the window on a transient unit
#        and returns immediately, letting systemd thaw user.slice.
USER_NAME="@@USER@@"
USER_HOME="@@HOME@@"
RUNTIME="/run/user/$(id -u "$USER_NAME")"

case "${1:-}" in
    pre)
        exec timeout 30 runuser -u "$USER_NAME" -- env \
            HOME="$USER_HOME" \
            DISPLAY=:0 \
            XAUTHORITY="$USER_HOME/.Xauthority" \
            XDG_RUNTIME_DIR="$RUNTIME" \
            "$USER_HOME/.local/bin/lid-hook" pre
        ;;
    post)
        exec systemd-run --no-block --collect --quiet \
            --unit="lid-resume-$$" \
            --property=KillMode=none \
            --property=TimeoutStartSec=300 \
            runuser -u "$USER_NAME" -- env \
            HOME="$USER_HOME" \
            DISPLAY=:0 \
            XAUTHORITY="$USER_HOME/.Xauthority" \
            XDG_RUNTIME_DIR="$RUNTIME" \
            "$USER_HOME/.local/bin/lid-hook" post
        ;;
esac
